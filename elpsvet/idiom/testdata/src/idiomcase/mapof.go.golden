package idiomcase

import "github.com/luthersystems/elps/lisp"

var coreSortedMap = lisp.BuiltinFunc("sorted-map") // want `lisp has a Go helper for sorted\-map: call LEnv\.SortedMapOf`

type status string

func mapOf(env *lisp.LEnv, id, desc *lisp.LVal, typ string, n int) {
	_, _ = env.MapOf("id", id, "type", typ, "n", n, "f", 1.5, "ok", true, "nil", nil, "b", []byte("x"), "l", lisp.Cells{id})
	_, _ = env.MapOf(id, 1)
	_, _ = env.MapOf(3, id)              // want `MapOf key of type int panics at run time`
	_, _ = env.MapOf("s", status("x"))   // want `MapOf value of type idiomcase.status panics at run time`
	_, _ = env.MapOf("s", []string{"x"}) // want `MapOf value of type \[\]string panics at run time`
	_, _ = env.MapOf("i", int64(1))      // want `MapOf value of type int64 panics at run time`
}

func sortedMap(env *lisp.LEnv, id, desc *lisp.LVal) (*lisp.LVal, error) {
	return env.MapOf("id", id, "description", desc)
}

// A key that is not a literal string gets SortedMapOf.
func sortedMapComputed(env *lisp.LEnv, k, v *lisp.LVal, kv []*lisp.LVal) {
	_, _ = env.SortedMapOf(k, v)  // want `use env.SortedMapOf, which returns the same map or error from the same checks`
	_, _ = env.SortedMapOf()      // want `use env.SortedMapOf`
	_, _ = env.SortedMapOf(kv...) // want `use env.SortedMapOf`
}
