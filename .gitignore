# NOTE: bare `elps` matches ANY path component named elps, not just the
# root binary -- it silently swallowed a new file under
# cmd/elpsvet/testdata/src/github.com/luthersystems/elps/. Left as-is for
# compatibility; testdata under that path needs `git add -f`.
elps
elpsvet
.firecrawl/
.claude/settings.local.json
.claude/worktrees/
.tmp/
node_modules/
*.vsix
editors/vscode/dist/
editors/vscode/bin/
.vscode/
.env

# scripts/fuzz.sh collects genuinely-new crashers here so CI can upload those
# rather than the whole committed corpus. Regenerated per run; never committed
# (the crasher itself belongs in <package>/testdata/fuzz/<Target>/).
fuzz-crashers/
